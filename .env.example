DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
# Repayment policy
LATE_FEE_PERCENT=5
LATE_FEE_GRACE_DAYS=3
REMINDER_DAYS_BEFORE=3
MIN_WITNESSES=1
MAX_WITNESSES=3
# Hosting (leave these out when running on this computer)
# DJANGO_ALLOWED_HOSTS=myapp.example.com
# DJANGO_SECRET_KEY=<long random value: python -c "import secrets; print(secrets.token_urlsafe(50))">
# DJANGO_CSRF_TRUSTED_ORIGINS=https://myapp.example.com
# DJANGO_BEHIND_PROXY=1
# SEED_PASSWORD_ADMIN=<choose a strong password>
# Sign-in throttling
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCK_MINUTES=15
